# Copie para .env (que é gitignored) e preencha para habilitar a narração via LLM.
# SEM este arquivo o projeto roda normalmente com a narração determinística.

# Anthropic Claude (provider padrão da narração)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opus mais potente (padrão); validado p/ esta chave. Não coloque comentário nesta linha.
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (alternativa; usado se OPENAI_API_KEY estiver definido)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini                 # opcional

# Mês reportado: parametrize com a flag --month AAAA-MM ou exportando REPORT_MONTH no shell
# (ex.: REPORT_MONTH=2025-05 make run). Padrao = mes do case (2025-04). Nao vai aqui no .env.
